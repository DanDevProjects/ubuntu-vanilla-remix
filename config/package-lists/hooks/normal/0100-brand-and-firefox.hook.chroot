#!/bin/sh
set -e

apt-get purge -y snapd || true
cat << 'EOF' > /etc/apt/preferences.d/nosnap.pref
Package: snapd
Pin: release a=*
Pin-Priority: -10
EOF

install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg | gpg --dearmor -o /etc/apt/keyrings/packages.mozilla.org.gpg
echo "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.gpg] https://packages.mozilla.org/apt mozilla main" > /etc/apt/sources.list.d/mozilla.list
cat << 'EOF' > /etc/apt/preferences.d/mozilla
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000
EOF
apt-get update
apt-get install -y firefox

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

sed -i 's/PRETTY_NAME="Ubuntu /PRETTY_NAME="Ubuntu Vanilla Remix /g' /usr/lib/os-release
sed -i 's/NAME="Ubuntu"/NAME="Ubuntu Vanilla Remix"/g' /usr/lib/os-release
sed -i 's/Ubuntu /Ubuntu Vanilla Remix /g' /etc/issue /etc/issue.net || true
sed -i 's/DISTRIB_ID=Ubuntu/DISTRIB_ID="Ubuntu Vanilla Remix"/g' /etc/lsb-release || true
sed -i 's/DISTRIB_DESCRIPTION="Ubuntu /DISTRIB_DESCRIPTION="Ubuntu Vanilla Remix /g' /etc/lsb-release || true
